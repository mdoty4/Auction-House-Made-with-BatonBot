datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("buyer")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

   listings     Listing[]
   bids         Bid[]
   cart         Cart?
   orders       Order[]
   sentMessages Message[] @relation("MessageSender")
   receivedMessages Message[] @relation("MessageReceiver")
   reviewsGiven Review[] @relation("ReviewReviewer")
   reviewsReceived Review[] @relation("ReviewReviewee")
}

model Category {
  id                 String   @id @default(uuid())
  name               String   @unique
  slug               String   @unique
  parentCategoryId   String?
  parentCategory     Category? @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id])
  childCategories    Category[] @relation("CategoryHierarchy")
  listings           Listing[]
}

model Listing {
  id             String    @id @default(uuid())
  sellerId       String
  seller         User      @relation(fields: [sellerId], references: [id])
  title          String
  description    String?
  categoryId     String?
  category       Category? @relation(fields: [categoryId], references: [id])
  condition      String
  priceType      String
  startPrice     Decimal   @db.Decimal(12, 2)
  buyNowPrice    Decimal?  @db.Decimal(12, 2)
  currentBid     Decimal?  @db.Decimal(12, 2)
  watchers       Int       @default(0)
  status         String    @default("active")
  endsAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

   bids           Bid[]
   cartItems      CartItem[]
   orderItems     OrderItem[]
}

model Bid {
  id         String   @id @default(uuid())
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id])
  bidderId   String
  bidder     User     @relation(fields: [bidderId], references: [id])
  amount     Decimal  @db.Decimal(12, 2)
  maxProxyBid Decimal? @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  isWinning  Boolean  @default(false)
}

model Cart {
  id          String     @id @default(uuid())
  userId      String     @unique
  user        User       @relation(fields: [userId], references: [id])
  cartItems   CartItem[]
}

model CartItem {
  id            String   @id @default(uuid())
  cartId        String
  cart          Cart     @relation(fields: [cartId], references: [id])
  listingId     String
  listing       Listing  @relation(fields: [listingId], references: [id])
  quantity      Int      @default(1)
  savedForLater Boolean  @default(false)

  @@unique([cartId, listingId])
}

model Order {
  id            String      @id @default(uuid())
  buyerId       String
  buyer         User        @relation(fields: [buyerId], references: [id])
  status        String      @default("placed")
  totalAmount   Decimal     @db.Decimal(12, 2)
  paymentStatus String      @default("mock_pending")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  orderItems    OrderItem[]
}

model OrderItem {
  id               String   @id @default(uuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id])
  listingId        String
  listing          Listing  @relation(fields: [listingId], references: [id])
  quantity         Int
  priceAtPurchase  Decimal  @db.Decimal(12, 2)
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  sender     User     @relation("MessageSender", fields: [senderId], references: [id])
  receiverId String
  receiver   User     @relation("MessageReceiver", fields: [receiverId], references: [id])
  listingId  String?
  content    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Review {
  id          String   @id @default(uuid())
  reviewerId  String
  reviewer    User     @relation("ReviewReviewer", fields: [reviewerId], references: [id])
  revieweeId  String
  reviewee    User     @relation("ReviewReviewee", fields: [revieweeId], references: [id])
  rating      Int
  comment     String?
  createdAt   DateTime @default(now())
}
